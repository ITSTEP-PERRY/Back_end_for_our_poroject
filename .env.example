# Локальные секреты — скопируйте в `.env` (корень solution или `src/Perry.Api`) и заполните.
# Файл `.env` не коммитить (уже в .gitignore как **.env).

# --- Product DB (LocalDB уже в appsettings.Development) ---
# ConnectionStrings__DefaultConnection=

# --- JWT Auth Service (#95 / #96) — тот же HS256 secret, что у Auth ---
Jwt__SigningSecret=PASTE_AUTH_Jwt_SigningSecret_HERE
Jwt__Key=PASTE_AUTH_Jwt_SigningSecret_HERE
Jwt__Issuer=Perry.AuthService
Jwt__Audience=Perry.Client
Jwt__SkipSignatureValidation=false
Jwt__MapInboundClaims=false
Jwt__RoleClaimType=role
Jwt__NameClaimType=sub

# --- Auth Internal service-to-service (#97) ---
AuthService__BaseUrl=https://perry-auth-service.orangeplant-910928aa.swedencentral.azurecontainerapps.io
AuthService__ServiceName=local-service
# Plaintext credential от Влада (НЕ hash). После вставки:
#   GET http://localhost:5272/api/dev/auth-internal-status → tokenOk=true
# AuthService__ServiceCredential=

# Docker / compose (если используете)
SA_PASSWORD=Perry_Dev_Passw0rd!

# SMTP Product (stub для dev)
SMTP_USE_STUB=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
