# Локальные секреты — скопируйте в `.env` (корень solution или `src/Perry.Api`) и заполните.
# Файл `.env` не коммитить (уже в .gitignore как **.env).

# --- Product DB: PostgreSQL (#A08) ---
# Локальный Postgres / Docker:
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=perry;Username=perry;Password=changeme

# Общий Supabase (строку даёт напарник) — только в локальный `.env`, не коммитить:
# ConnectionStrings__DefaultConnection=Host=….pooler.supabase.com;Port=5432;Database=postgres;Username=…;Password=…;SSL Mode=Require;Trust Server Certificate=true

# Docker Compose — локально (docker-compose.dev.yml):
POSTGRES_DB=perry
POSTGRES_USER=perry
POSTGRES_PASSWORD=changeme

# Docker Compose — custom server (#D01, корневой docker-compose.yml):
# Внешняя БД (тот же смысл, что ConnectionStrings__DefaultConnection).
ConnectionString=Host=YOUR_DB_HOST;Port=5432;Database=perry;Username=perry;Password=changeme
NETWORK_MODE=host

# --- JWT Auth Service (#95 / #96) ---
# Local demo default (Swagger / catalog work out of the box).
# For real login with Azure Auth: replace with the SAME HS256 secret as Auth Service.
Jwt__SigningSecret=changeme-dev-jwt-signing-key-32chars
Jwt__Key=changeme-dev-jwt-signing-key-32chars
Jwt__Issuer=Perry.AuthService
Jwt__Audience=Perry.Client
Jwt__SkipSignatureValidation=false
Jwt__MapInboundClaims=false
Jwt__RoleClaimType=role
Jwt__NameClaimType=sub

# docker-compose JWT (same value as Jwt__SigningSecret)
JWT_KEY=changeme-dev-jwt-signing-key-32chars

# --- Auth Internal service-to-service (#97) ---
AuthService__BaseUrl=https://perry-auth-service.orangeplant-910928aa.swedencentral.azurecontainerapps.io
AuthService__ServiceName=local-service
# AuthService__ServiceCredential=

# SMTP Product (stub для dev)
SMTP_USE_STUB=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
