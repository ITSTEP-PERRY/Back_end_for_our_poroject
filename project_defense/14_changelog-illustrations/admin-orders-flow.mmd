sequenceDiagram
  participant Admin as Admin UI
  participant API as OrdersController
  participant S as OrderService
  participant DB as PostgreSQL
  Admin->>API: GET /api/orders/admin?filters
  API->>S: query
  S->>DB: Orders
  Admin->>API: PUT /orders/id/status
  API->>S: status + UpdatedAtUtc
  S-->>Admin: lastUpdateUtc
