<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Perry.Domain\Perry.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- SQL Server EF history kept for reference; not compiled (provider is PostgreSQL). -->
  <ItemGroup>
    <Compile Remove="Persistence\_archive_SqlServerMigrations\**" />
    <None Include="Persistence\_archive_SqlServerMigrations\**" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Persistence\dummyjson-products.json" LogicalName="Perry.Infrastructure.Persistence.dummyjson-products.json" />
  </ItemGroup>

</Project>


