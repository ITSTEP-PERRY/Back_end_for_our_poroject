@page
@model Perry.Web.Pages.Account.LoginModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Sign in";
    var hasError = !string.IsNullOrEmpty(Model.Error);
}

<a class="auth-back" asp-page="/Index">← Perry</a>

@if (!string.IsNullOrEmpty(Model.VerifyRedirectUrl))
{
    <p class="auth-alert" style="max-width:440px;margin:16px auto;text-align:center;">
        Opening verification…
        <a href="@Model.VerifyRedirectUrl">Continue</a>
    </p>
    <script>
        window.location.replace(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.VerifyRedirectUrl)));
    </script>
    <noscript>
        <meta http-equiv="refresh" content="0;url=@Model.VerifyRedirectUrl" />
    </noscript>
}

<div class="auth-modal">
    <div class="auth-modal__body">
        <div class="auth-modal__form-col">
            @if (hasError)
            {
                <div class="auth-alert">@Model.Error</div>
            }

            <form method="post" class="login-form" data-auth-form novalidate>
                <input type="hidden" asp-for="ReturnUrl" />

                <div class="login-form__titles">
                    <h1>Welcome back</h1>
                    <h2>Login into your account</h2>
                </div>

                <div class="login-form__fields">
                    <div class="perry-field @(hasError ? "perry-field--error" : null)" data-field>
                        <span class="perry-field__label">Email</span>
                        <div class="perry-field__control">
                            <input class="perry-field__input"
                                   asp-for="Login"
                                   type="text"
                                   placeholder="Enter your email"
                                   autocomplete="username"
                                   data-required-input
                                   data-error-empty="Wrong or invalid email address" />
                        </div>
                        <p class="perry-field__error" data-field-error hidden></p>
                    </div>

                    <div class="perry-field perry-field--password @(hasError ? "perry-field--error" : null)" data-field>
                        <span class="perry-field__label">Password</span>
                        <div class="perry-field__control">
                            <input class="perry-field__input"
                                   asp-for="Password"
                                   type="password"
                                   placeholder="Enter your password"
                                   autocomplete="current-password"
                                   data-password-input
                                   data-required-input
                                   data-error-empty="Incorrect password" />
                            <button type="button"
                                    class="perry-field__toggle"
                                    data-password-toggle
                                    data-icon-open="@Url.Content("~/icons/Eye_open.svg")"
                                    data-icon-closed="@Url.Content("~/icons/Eye_closed.svg")"
                                    aria-label="Show password">
                                <img src="@Url.Content("~/icons/Eye_closed.svg")" alt="Show password" width="24" height="24" />
                            </button>
                        </div>
                        <p class="perry-field__error" data-field-error hidden></p>
                    </div>

                    <div class="login-form__row">
                        <label class="login-form__remember">
                            <input type="checkbox" name="StaySignedIn" value="true" />
                            Stay signed in
                        </label>
                        <a class="login-form__forgot" asp-page="/Account/ForgotPassword">Forgot password?</a>
                    </div>
                </div>

                <button type="submit" class="perry-btn">Log in</button>
            </form>

            <p class="auth-modal__signup">
                Don't have an account?
                <a asp-page="/Account/Register">Sign Up</a>
            </p>
        </div>

        <div class="auth-modal__image">
            <img src="@Url.Content("~/images/SiginSignup.png")" alt="Sign in" width="530" height="632" />
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/auth.js" asp-append-version="true"></script>
}
