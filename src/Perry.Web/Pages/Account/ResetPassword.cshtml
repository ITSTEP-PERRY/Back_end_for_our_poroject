@page
@model Perry.Web.Pages.Account.ResetPasswordModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Reset password";
    var pwdError = Model.PasswordEmpty || Model.PasswordWeak;
    var confirmError = Model.PasswordMismatch || Model.PasswordEmpty;
}

<a class="auth-back" asp-page="/Account/ForgotPassword">← Back</a>

<div class="auth-modal">
    <div class="auth-modal__body">
        <div class="auth-modal__form-col">
            @if (!string.IsNullOrEmpty(Model.Error))
            {
                <div class="auth-alert">@Model.Error</div>
            }

            <form method="post" class="login-form" data-auth-form data-reset-form novalidate>
                <input type="hidden" asp-for="Token" />

                <div class="login-form__titles">
                    <h1>Reset password</h1>
                    <h2>Set a new password for your account</h2>
                </div>

                <div class="login-form__fields">
                    <div class="perry-field perry-field--password @(pwdError ? "perry-field--error" : null)" data-field>
                        <span class="perry-field__label">New password</span>
                        <div class="perry-field__control">
                            <input class="perry-field__input"
                                   asp-for="NewPassword"
                                   type="password"
                                   placeholder="Enter new password"
                                   autocomplete="new-password"
                                   data-password-input
                                   data-required-input
                                   data-password-rules
                                   data-confirm-source
                                   data-error-empty="This field is necessary to continue!" />
                            <button type="button"
                                    class="perry-field__toggle"
                                    data-password-toggle
                                    data-icon-open="@Url.Content("~/icons/Eye_open.svg")"
                                    data-icon-closed="@Url.Content("~/icons/Eye_closed.svg")"
                                    aria-label="Show password">
                                <img src="@Url.Content("~/icons/Eye_closed.svg")" alt="Show password" width="24" height="24" />
                            </button>
                        </div>
                        <p class="perry-field__error" data-field-error @(pwdError ? null : "hidden")>
                            @if (Model.PasswordEmpty)
                            {
                                @:This field is necessary to continue!
                            }
                            else if (Model.PasswordWeak)
                            {
                                @:Password must contain at least 1 uppercase letter, 1 lowercase letter, 1 digit, and be at least 8 characters long
                            }
                        </p>
                    </div>

                    <div class="perry-field perry-field--password @(confirmError ? "perry-field--error" : null)" data-field>
                        <span class="perry-field__label">Repeat password</span>
                        <div class="perry-field__control">
                            <input class="perry-field__input"
                                   asp-for="RepeatPassword"
                                   type="password"
                                   placeholder="Repeat new password"
                                   autocomplete="new-password"
                                   data-password-input
                                   data-required-input
                                   data-confirm-target
                                   data-error-empty="This field is necessary to continue!"
                                   data-error-mismatch="Passwords must match" />
                            <button type="button"
                                    class="perry-field__toggle"
                                    data-password-toggle
                                    data-icon-open="@Url.Content("~/icons/Eye_open.svg")"
                                    data-icon-closed="@Url.Content("~/icons/Eye_closed.svg")"
                                    aria-label="Show password">
                                <img src="@Url.Content("~/icons/Eye_closed.svg")" alt="Show password" width="24" height="24" />
                            </button>
                        </div>
                        <p class="perry-field__error" data-field-error @(confirmError ? null : "hidden")>
                            @if (Model.PasswordEmpty && string.IsNullOrWhiteSpace(Model.RepeatPassword))
                            {
                                @:This field is necessary to continue!
                            }
                            else if (Model.PasswordMismatch)
                            {
                                @:Passwords must match
                            }
                        </p>
                    </div>
                </div>

                <button type="submit" class="perry-btn">Continue</button>
            </form>
        </div>

        <div class="auth-modal__image">
            <img src="@Url.Content("~/images/SiginSignup.png")" alt="Reset password" width="530" height="632" />
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/auth.js" asp-append-version="true"></script>
}
