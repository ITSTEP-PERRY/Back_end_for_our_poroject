@page
@model Perry.Web.Pages.Account.ForgotPasswordModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Forgot password";
}

<a class="auth-back" asp-page="/Account/Login">← Back</a>

<div class="auth-modal">
    <div class="auth-modal__body">
        <div class="auth-modal__form-col">
            <form method="post" class="login-form" data-auth-form novalidate>
                <div class="login-form__titles">
                    <h1>Forgot password</h1>
                    <h2>Enter your email to reset your password</h2>
                </div>

                <div class="login-form__fields">
                    <div class="perry-field @(Model.EmailInvalid ? "perry-field--error" : null)" data-field>
                        <span class="perry-field__label">Email</span>
                        <div class="perry-field__control">
                            <input class="perry-field__input"
                                   asp-for="Email"
                                   type="email"
                                   placeholder="Enter your email"
                                   autocomplete="email"
                                   data-required-input
                                   data-email-input
                                   data-error-empty="Wrong or invalid email address" />
                        </div>
                        <p class="perry-field__error" data-field-error @(Model.EmailInvalid ? null : "hidden")>
                            @(Model.EmailInvalid ? "Wrong or invalid email address" : "")
                        </p>
                    </div>
                </div>

                <button type="submit" class="perry-btn">Continue</button>
            </form>

            @if (!string.IsNullOrEmpty(Model.DevResetHint))
            {
                <p class="dev-code-hint">Dev stub — reset link: <a href="@Model.DevResetHint">@Model.DevResetHint</a></p>
            }
        </div>

        <div class="auth-modal__image">
            <img src="@Url.Content("~/images/SiginSignup.png")" alt="Forgot password" width="530" height="632" />
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/auth.js" asp-append-version="true"></script>
}
