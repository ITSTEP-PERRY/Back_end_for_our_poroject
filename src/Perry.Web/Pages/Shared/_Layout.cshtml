<!DOCTYPE html>
<html lang="en">
@*
  Общий каркас сайта: шапка (лого, поиск, корзина) + контент + подвал.
  Соответствует header/footer из макета Figma / скринов Privacy.
*@
@using Perry.Infrastructure.Services
@using Perry.Web.Extensions
@inject ICartService CartService
@{
    var cartCount = await Context.GetCartBadgeCountAsync(CartService);
    var isAuth = User.Identity?.IsAuthenticated ?? false;
    var isAdmin = User.IsInRole("Admin");
}
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Perry</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Mulish:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="@(ViewData["LegalActive"] != null ? "legal-shell" : null)">
    <header class="site-header">
        <div class="header-inner">
            <div class="header-brand">
                <a class="header-menu" asp-page="/Products/Index" aria-label="Catalog">
                    <img src="~/icons/menu.svg" alt="" width="24" height="24" />
                </a>
                <a class="logo" asp-page="/Index">PERRY</a>
            </div>

            <form class="search-form" method="get" asp-page="/Products/Index">
                <input type="search" name="search" placeholder="Search..." value="@Context.Request.Query["search"]" />
                <button type="submit" aria-label="Search">
                    <img src="~/icons/search.svg" alt="" width="18" height="18" />
                </button>
            </form>

            <nav class="header-actions">
                @if (isAuth)
                {
                    <a asp-page="/Account/Profile" class="header-icon" aria-label="@User.Identity!.Name">
                        <img src="~/icons/account.svg" alt="" width="24" height="24" />
                    </a>
                }
                else
                {
                    <a asp-page="/Account/Login" class="header-icon" aria-label="Sign in">
                        <img src="~/icons/account.svg" alt="" width="24" height="24" />
                    </a>
                }
                @if (isAdmin)
                {
                    <a asp-page="/Admin/Index" class="header-link">Admin</a>
                }
                <a asp-page="/Cart/Index" class="header-icon cart-link" aria-label="Cart">
                    <img src="~/icons/cart.svg" alt="" width="24" height="24" />
                    @if (cartCount > 0)
                    {
                        <span class="cart-badge">@cartCount</span>
                    }
                </a>
            </nav>
        </div>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="footer-inner">
            <div class="footer-col">
                <h4>Support</h4>
                <a href="#">Contact us</a>
                <a href="#">FAQ</a>
            </div>
            <div class="footer-col">
                <h4>Legal notice</h4>
                <a asp-page="/Terms">Terms and conditions</a>
                <a asp-page="/License">License agreement</a>
                <a asp-page="/Privacy">Privacy policy</a>
            </div>
            <div class="footer-col">
                <h4>Social media</h4>
                <div class="social-row" aria-hidden="true">
                    <span></span><span></span><span></span><span></span><span></span>
                </div>
            </div>
        </div>
        <div class="footer-bottom">
            <span class="logo logo-sm">PERRY</span>
            <span>© 2024 Perry. All rights reserved.</span>
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
