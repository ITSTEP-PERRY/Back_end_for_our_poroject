@page "{id:guid}"
@model Perry.Web.Pages.Admin.EditModel
@using Perry.Domain.Enums
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = Model.IsCreate ? "Create product" : "Edit product";
}

<div class="admin-top">
    <h1>@(Model.IsCreate ? "Create product" : "Product card")</h1>
    <div class="admin-top-actions">
        <a class="btn btn-ghost" asp-page="/Admin/Products">← Products</a>
        @if (!Model.IsCreate)
        {
            <a class="btn btn-ghost" asp-page="/Products/Details" asp-route-id="@Model.Id">На витрине</a>
        }
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert alert-ok">@Model.Message</div>
}
@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="alert alert-error">@Model.Error</div>
}

<form method="post" enctype="multipart/form-data" class="ap-edit" id="product-edit-form">
    <input type="hidden" name="Create" value="@Model.IsCreate.ToString().ToLowerInvariant()" />
    <input type="hidden" name="Id" value="@Model.Id" />

    <div class="ap-edit__grid">
        <section class="admin-card">
            <h2>Основное</h2>
            <div class="admin-form">
                <label>Название *
                    <input asp-for="Form.Name" required />
                </label>
                <label>Описание
                    <textarea asp-for="Form.Description" rows="4"></textarea>
                </label>
                <label>Категория *
                    <select asp-for="Form.CategoryId" required class="ap-cat-select">
                        <option value="">— выберите —</option>
                        @foreach (var root in Model.CategoryTree)
                        {
                            @* @RenderCatOptions(root) *@
                        }
                    </select>
                </label>
                <div class="form-row">
                    <label>SKU <input asp-for="Form.Sku" placeholder="авто" /></label>
                    <label>Slug <input asp-for="Form.Slug" placeholder="auto" /></label>
                    <label>Brand <input asp-for="Form.Brand" /></label>
                </div>
                <div class="form-row">
                    <label>Price * <input asp-for="Form.Price" type="number" step="0.01" min="0" required /></label>
                    <label>Old price <input asp-for="Form.OldPrice" type="number" step="0.01" min="0" /></label>
                    <label>Stock <input asp-for="Form.StockQuantity" type="number" min="0" /></label>
                </div>
                <div class="form-row form-row--2">
                    <label>Status
                        <select asp-for="Form.Status" asp-items="Html.GetEnumSelectList<ProductStatus>()"></select>
                    </label>
                    <label class="checkbox-row">
                        <input asp-for="Form.IsBestSeller" /> Best seller
                    </label>
                </div>
                @if (Model.CurrentImageUrls.Count > 0)
                {
                    <div class="edit-preview-row">
                        @foreach (var url in Model.CurrentImageUrls.Take(4))
                        {
                            <div class="edit-preview"><img src="@url" alt="" /></div>
                        }
                    </div>
                }
                <label>Изображение (primary)
                    <input asp-for="Form.Image" type="file" accept="image/*" />
                </label>
            </div>
        </section>

        <section class="admin-card">
            <h2>About product <span class="admin-card__hint">аккордеон на карточке</span></h2>
            <div class="ap-dyn" data-dyn="about">
                <div class="ap-dyn__list" data-dyn-list>
                    @for (var i = 0; i < Model.Form.AboutItems.Count; i++)
                    {
                        <div class="ap-dyn__item" data-dyn-item>
                            <label>Заголовок
                                <input name="Form.AboutItems[@i].Title" value="@Model.Form.AboutItems[i].Title" />
                            </label>
                            <label>Текст
                                <textarea name="Form.AboutItems[@i].Description" rows="2">@Model.Form.AboutItems[i].Description</textarea>
                            </label>
                            <button type="button" class="btn btn-ghost ap-dyn__remove" data-dyn-remove>Удалить</button>
                        </div>
                    }
                </div>
                <button type="button" class="btn btn-ghost" data-dyn-add="about">+ About item</button>
            </div>
        </section>

        <section class="admin-card">
            <h2>Product details <span class="admin-card__hint">таблица характеристик</span></h2>
            <div class="ap-dyn" data-dyn="attrs">
                <div class="ap-dyn__list" data-dyn-list>
                    @for (var i = 0; i < Model.Form.Attributes.Count; i++)
                    {
                        <div class="ap-dyn__item ap-dyn__item--row" data-dyn-item>
                            <label>Name
                                <input name="Form.Attributes[@i].Name" value="@Model.Form.Attributes[i].Name" />
                            </label>
                            <label>Value
                                <input name="Form.Attributes[@i].Value" value="@Model.Form.Attributes[i].Value" />
                            </label>
                            <label class="checkbox-row">
                                <input type="checkbox" name="Form.Attributes[@i].IsFilterable" value="true"
                                       @(Model.Form.Attributes[i].IsFilterable ? "checked" : null) /> Filter
                            </label>
                            <button type="button" class="btn btn-ghost ap-dyn__remove" data-dyn-remove>×</button>
                        </div>
                    }
                </div>
                <button type="button" class="btn btn-ghost" data-dyn-add="attrs">+ Spec</button>
            </div>
        </section>
    </div>

    <div class="ap-edit__footer">
        <button type="submit" class="btn btn-primary">@(Model.IsCreate ? "Create" : "Save")</button>
        <a class="btn btn-ghost" asp-page="/Admin/Products">Cancel</a>
    </div>
</form>

<template id="tpl-about">
    <div class="ap-dyn__item" data-dyn-item>
        <label>Заголовок
            <input data-name="Title" />
        </label>
        <label>Текст
            <textarea data-name="Description" rows="2"></textarea>
        </label>
        <button type="button" class="btn btn-ghost ap-dyn__remove" data-dyn-remove>Удалить</button>
    </div>
</template>
<template id="tpl-attrs">
    <div class="ap-dyn__item ap-dyn__item--row" data-dyn-item>
        <label>Name
            <input data-name="Name" />
        </label>
        <label>Value
            <input data-name="Value" />
        </label>
        <label class="checkbox-row">
            <input type="checkbox" data-name="IsFilterable" value="true" /> Filter
        </label>
        <button type="button" class="btn btn-ghost ap-dyn__remove" data-dyn-remove>×</button>
    </div>
</template>

