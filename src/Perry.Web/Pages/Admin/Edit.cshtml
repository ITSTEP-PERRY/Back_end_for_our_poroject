@page
@model Perry.Web.Pages.Admin.EditModel

@{
    ViewData["Title"] = Model.IsCreate ? "Создание товара" : "Редактирование товара";
}

<div class="admin-page">

    <div class="admin-header">
        <div>
            <h1>@(Model.IsCreate ? "Создание товара" : "Редактирование товара")</h1>
            <p class="admin-subtitle">
                @(Model.IsCreate
                    ? "Добавление нового товара"
                    : "Изменение информации о товаре")
            </p>
        </div>

        <a asp-page="./Products" class="btn btn-secondary">
            ← Назад к товарам
        </a>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.Message))
    {
        <div class="alert alert-success">
            @Model.Message
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.Error))
    {
        <div class="alert alert-danger">
            @Model.Error
        </div>
    }

    <form method="post"
          enctype="multipart/form-data"
          class="admin-form">

        <div asp-validation-summary="ModelOnly"
             class="text-danger">
        </div>

        <div class="form-section">

            <h2>Основное</h2>

            <div class="form-group">

                <label asp-for="Form.Name">
                    Название *
                </label>

                <input asp-for="Form.Name"
                       class="form-control"
                       required />

                <span asp-validation-for="Form.Name"
                      class="text-danger">
                </span>

            </div>

            <div class="form-group">

                <label asp-for="Form.Description">
                    Описание
                </label>

                <textarea asp-for="Form.Description"
                          class="form-control"
                          rows="5">
                </textarea>

                <span asp-validation-for="Form.Description"
                      class="text-danger">
                </span>

            </div>

            <div class="form-row">

                <div class="form-group">

                    <label asp-for="Form.CategoryId">
                        Категория *
                    </label>

                    <select asp-for="Form.CategoryId"
                            class="form-control"
                            required>

                        <option value="">
                            — выберите категорию —
                        </option>

                        @foreach (var root in Model.CategoryTree)
                        {
                            <option value="@root.Id">
                                @root.Name
                            </option>

                            @foreach (var child in root.Children)
                            {
                                <option value="@child.Id">
                                    &nbsp;&nbsp;&nbsp;↳ @child.Name
                                </option>

                                @foreach (var child2 in child.Children)
                                {
                                    <option value="@child2.Id">
                                        &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;↳ @child2.Name
                                    </option>

                                    @foreach (var child3 in child2.Children)
                                    {
                                        <option value="@child3.Id">
                                            &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;↳ @child3.Name
                                        </option>
                                    }
                                }
                            }
                        }

                    </select>

                    <span asp-validation-for="Form.CategoryId"
                          class="text-danger">
                    </span>

                </div>

                <div class="form-group">

                    <label asp-for="Form.Brand">
                        Бренд
                    </label>

                    <input asp-for="Form.Brand"
                           class="form-control" />

                    <span asp-validation-for="Form.Brand"
                          class="text-danger">
                    </span>

                </div>

            </div>

            <div class="form-row">

                <div class="form-group">

                    <label asp-for="Form.Price">
                        Цена *
                    </label>

                    <input asp-for="Form.Price"
                           type="number"
                           step="0.01"
                           min="0"
                           class="form-control"
                           required />

                    <span asp-validation-for="Form.Price"
                          class="text-danger">
                    </span>

                </div>

                <div class="form-group">

                    <label asp-for="Form.OldPrice">
                        Старая цена
                    </label>

                    <input asp-for="Form.OldPrice"
                           type="number"
                           step="0.01"
                           min="0"
                           class="form-control" />

                    <span asp-validation-for="Form.OldPrice"
                          class="text-danger">
                    </span>

                </div>

            </div>

            <div class="form-row">

                <div class="form-group">

                    <label asp-for="Form.StockQuantity">
                        Количество на складе
                    </label>

                    <input asp-for="Form.StockQuantity"
                           type="number"
                           min="0"
                           class="form-control" />

                    <span asp-validation-for="Form.StockQuantity"
                          class="text-danger">
                    </span>

                </div>

                <div class="form-group">

                    <label asp-for="Form.Sku">
                        SKU
                    </label>

                    <input asp-for="Form.Sku"
                           class="form-control" />

                    <span asp-validation-for="Form.Sku"
                          class="text-danger">
                    </span>

                </div>

            </div>

            <div class="form-row">

                <div class="form-group">

                    <label asp-for="Form.Slug">
                        Slug
                    </label>

                    <input asp-for="Form.Slug"
                           class="form-control" />

                    <span asp-validation-for="Form.Slug"
                          class="text-danger">
                    </span>

                </div>

                <div class="form-group">

                    <label asp-for="Form.Status">
                        Статус
                    </label>

                    <select asp-for="Form.Status"
                            asp-items="Html.GetEnumSelectList<Perry.Domain.Enums.ProductStatus>()"
                            class="form-control">
                    </select>

                    <span asp-validation-for="Form.Status"
                          class="text-danger">
                    </span>

                </div>

            </div>

            <div class="form-group">

                <label>
                    <input asp-for="Form.IsBestSeller" />
                    Лучший продавец
                </label>

            </div>

        </div>


        <div class="form-section">

            <h2>Изображение</h2>

            @if (Model.CurrentImageUrls.Count > 0)
            {
                <div class="current-images">

                    @foreach (var imageUrl in Model.CurrentImageUrls)
                    {
                        <div class="current-image">

                            <img src="@imageUrl"
                                 alt="Изображение товара"
                                 style="max-width: 180px; max-height: 180px;" />

                        </div>
                    }

                </div>
            }

            <div class="form-group">

                <label asp-for="Form.Image">
                    Новое изображение
                </label>

                <input asp-for="Form.Image"
                       type="file"
                       accept="image/*"
                       class="form-control" />

                <span asp-validation-for="Form.Image"
                      class="text-danger">
                </span>

            </div>

        </div>


        <div class="form-section">

            <h2>About</h2>

            @for (var i = 0; i < Model.Form.AboutItems.Count; i++)
            {
                <div class="form-row">

                    <div class="form-group">

                        <label>
                            Заголовок
                        </label>

                        <input asp-for="Form.AboutItems[i].Title"
                               class="form-control" />

                    </div>

                    <div class="form-group">

                        <label>
                            Описание
                        </label>

                        <input asp-for="Form.AboutItems[i].Description"
                               class="form-control" />

                    </div>

                </div>
            }

        </div>


        <div class="form-section">

            <h2>Характеристики</h2>

            @for (var i = 0; i < Model.Form.Attributes.Count; i++)
            {
                <div class="form-row">

                    <div class="form-group">

                        <label>
                            Название характеристики
                        </label>

                        <input asp-for="Form.Attributes[i].Name"
                               class="form-control" />

                    </div>

                    <div class="form-group">

                        <label>
                            Значение
                        </label>

                        <input asp-for="Form.Attributes[i].Value"
                               class="form-control" />

                    </div>

                    <div class="form-group">

                        <label>
                            <input asp-for="Form.Attributes[i].IsFilterable" />
                            Фильтруемая
                        </label>

                    </div>

                </div>
            }

        </div>


        <div class="form-actions">

            <button type="submit"
                    class="btn btn-primary">
                Сохранить
            </button>

            <a asp-page="./Products"
               class="btn btn-secondary">
                Отмена
            </a>

        </div>

    </form>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}
